[gd_resource type="ShaderMaterial" format=3 uid="uid://1oujwkm3smcs"]

[sub_resource type="Shader" id="Shader_03heq"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx, unshaded;

uniform vec4 albedo : source_color;
uniform float flash_frequency = 1.0;
uniform float flash_intensity = 0.5;

void fragment() {
	ALBEDO = albedo.rgb;
	ALPHA = sin(TIME*flash_frequency)*sin(TIME*flash_frequency)*flash_intensity;
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_03heq")
shader_parameter/albedo = Color(0, 0.5999999, 1, 1)
shader_parameter/flash_frequency = 1.0
shader_parameter/flash_intensity = 0.01
